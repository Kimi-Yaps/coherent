rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email.matches('.*clinical.*') ||
          request.auth.token.email.matches('.*clinician.*') ||
          request.auth.token.email == 'clinical-desk@coherent.care'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'clinician_admin', 'clinician']))
      );
    }

    // User profiles & roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Counselor profiles
    match /counselors/{counselorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // AI Support Care Companion Sessions
    match /ai_sessions/{sessionId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Appointments & Bookings
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Clinical Relapse Watchlist Triggers
    match /watchlist/{triggerId} {
      allow read, write: if isAuthenticated();
    }

    // Clinical Flags & Transcripts
    match /clinical_flags/{flagId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }
  }
}

