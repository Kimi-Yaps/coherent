rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && (
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email.matches('.*clinical.*') ||
          request.auth.token.email.matches('.*clinician.*') ||
          request.auth.token.email.matches('.*doctor.*') ||
          request.auth.token.email.matches('.*care.*') ||
          request.auth.token.email == 'clinical-desk@coherent.care'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'clinician_admin', 'clinician']))
      );
    }

    // User profiles & roles - Authenticated users & clinicians can view rosters; users can edit own profile
    match /users/{userId} {
      allow read: if isAuthenticated() || true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Counselor profiles
    match /counselors/{counselorId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == counselorId || isAdmin());
    }

    // AI Support Care Companion Sessions
    match /ai_sessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Appointments & Bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Clinical Relapse Watchlist Triggers (Evidence-based taxonomy readable by all clients)
    match /watchlist/{triggerId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Clinical Flags & Transcripts (Clinician review)
    match /clinical_flags/{flagId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}

